{
  "channel": "web",
  "version": "0.6.2",
  "notes": "v0.6.2 Web 启动热修复：修复 Uvicorn 重载导入失败，并让 FRONTEND_PORT 与 Vite 实际监听地址严格一致。",
  "pub_date": "2026-07-12T13:40:14.279Z",
  "archive": {
    "name": "scholar-assist-web-v0.6.2.tar.gz",
    "url": "https://raw.githubusercontent.com/xiyouss16/scholar-assist-updates/main/scholar-assist-web-v0.6.2.tar.gz",
    "sha256": "7d7cc65524f88ac0ab0343f1fb439ced7964388aabbac4326e260feaa2023d2f",
    "size": 1519911
  },
  "install": {
    "docker": "docker compose up --build",
    "docker_compose": "SCHOLAR_ASSIST_ACCESS_CODE=your-code docker compose up --build",
    "local_backend": "cd backend && python3 main.py",
    "local_frontend": "npm run web:dev",
    "open_output_command": "npm run open:output -- <path-to-docx-or-pdf>",
    "wps_or_libreoffice": "Open exported DOCX/PDF with WPS Office or LibreOffice when Microsoft Word is unavailable."
  },
  "platforms": {
    "macos": {
      "recommended": "npm run web:start",
      "backend": "python3 backend/main.py",
      "frontend": "npm run web:dev",
      "open_output_command": "npm run open:output -- ~/Downloads/paper.docx"
    },
    "windows": {
      "recommended": "npm run web:start",
      "backend": "py -3 backend/main.py",
      "frontend": "npm run web:dev",
      "open_output_command": "npm run open:output -- C:\\\\Users\\\\you\\\\Downloads\\\\paper.docx",
      "windows_guide": "docs/WINDOWS_WEB_GUIDE.md"
    },
    "linux": {
      "recommended": "npm run web:start",
      "backend": "python3 backend/main.py",
      "frontend": "npm run web:dev",
      "open_output_command": "npm run open:output -- ~/Downloads/paper.docx"
    },
    "docker": {
      "docker_compose": "docker compose up --build",
      "healthcheck": "GET /api/health",
      "data_volume": "scholar-assist-data"
    }
  },
  "security_env": [
    "SCHOLAR_ASSIST_ACCESS_CODE",
    "SCHOLAR_ASSIST_RATE_LIMIT_PER_MINUTE",
    "SCHOLAR_ASSIST_CORS_ORIGINS",
    "SCHOLAR_ASSIST_AI_PROVIDER",
    "SCHOLAR_ASSIST_AI_API_KEY",
    "SCHOLAR_ASSIST_AI_BASE_URL",
    "SCHOLAR_ASSIST_AI_MODEL"
  ],
  "docs": {
    "first_use": "docs/FIRST_USE_GUIDE.md",
    "web_deployment": "docs/WEB_DEPLOYMENT.md",
    "windows_guide": "docs/WINDOWS_WEB_GUIDE.md"
  },
  "smoke": {
    "command": "npm run smoke:web",
    "health_url": "http://127.0.0.1:8765/api/health"
  },
  "apple_developer_id_required": false
}
